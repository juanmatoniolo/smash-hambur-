{
  "rules": {
    "usuarios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('superadmin').val() === true",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('superadmin').val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "nombre": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "superadmin": { ".validate": "newData.isBoolean()" },
        "locales": {
          "$slug": { ".validate": "newData.val() === true && $slug.matches(/^[a-z0-9-]{2,40}$/)" }
        },
        "$otro": { ".validate": false }
      }
    },

    "solicitudes": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('superadmin').val() === true",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('superadmin').val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['email', 'fecha']) && newData.child('email').val() === auth.token.email",
        "email": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "nombre": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "fecha": { ".validate": "newData.isNumber()" },
        "$otro": { ".validate": false }
      }
    },

    "locales": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('superadmin').val() === true",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('superadmin').val() === true",
      "$slug": {
        ".validate": "$slug.matches(/^[a-z0-9-]{2,40}$/)",

        "comidas": {
          ".read": true,
          ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('locales').child($slug).val() === true || root.child('usuarios').child(auth.uid).child('superadmin').val() === true)",
          "$id": {
            ".validate": "newData.hasChildren(['nombre', 'categoria', 'valor'])",
            "nombre": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "descripcion": { ".validate": "newData.isString() && newData.val().length <= 400" },
            "categoria": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "valor": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000" },
            "oferta": { ".validate": "newData.isBoolean()" },
            "valorOferta": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000" },
            "imagen": { ".validate": "newData.isString() && newData.val().length <= 2000 && (newData.val() === '' || newData.val().beginsWith('https://'))" },
            "medallones": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
            "oculto": { ".validate": "newData.isBoolean()" },
            "$otro": { ".validate": false }
          }
        },

        "datos": {
          ".read": true,
          ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('locales').child($slug).val() === true || root.child('usuarios').child(auth.uid).child('superadmin').val() === true)",
          "nombre": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "whatsapp": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "direccion": { ".validate": "newData.isString() && newData.val().length <= 160" },
          "alias": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "costoEnvio": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000" },
          "extras": {
            "medallon": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000" },
            "$otro": { ".validate": false }
          },
          "redes": {
            "instagram": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "facebook": { ".validate": "newData.isString() && newData.val().length <= 160" },
            "$otro": { ".validate": false }
          },
          "$otro": { ".validate": false }
        },

        "horarios": {
          ".read": true,
          ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('locales').child($slug).val() === true || root.child('usuarios').child(auth.uid).child('superadmin').val() === true)",
          "$dia": {
            ".validate": "$dia.matches(/^(lunes|martes|miercoles|jueves|viernes|sabado|domingo)$/)",
            "cerrado": { ".validate": "newData.isBoolean()" },
            "franjas": {
              "$i": {
                ".validate": "$i.matches(/^[0-3]$/) && newData.hasChildren(['desde', 'hasta'])",
                "desde": { ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)" },
                "hasta": { ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)" },
                "$otro": { ".validate": false }
              }
            },
            "$otro": { ".validate": false }
          }
        },

        "visitas": {
          ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('locales').child($slug).val() === true || root.child('usuarios').child(auth.uid).child('superadmin').val() === true)",
          "total": {
            ".write": true,
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)"
          },
          "dias": {
            "$dia": {
              ".write": true,
              ".validate": "$dia.matches(/^20[0-9]{2}-[01][0-9]-[0-3][0-9]$/) && newData.isNumber() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)"
            }
          }
        },

        "$otro": { ".validate": false }
      }
    }
  }
}
